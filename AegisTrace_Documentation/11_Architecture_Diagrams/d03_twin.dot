digraph G { graph [bgcolor="white", fontname="DejaVu Sans", pad=0.3, nodesep=0.35, ranksep=0.5]; node [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled", fillcolor="#EAF6FB", color="#0B1F3A", penwidth=1.4, margin="0.18,0.10"]; edge [fontname="DejaVu Sans", fontsize=9, color="#0E7490", penwidth=1.3, arrowsize=0.8]; rankdir=LR; nodesep=0.2; labelloc=t; label="Figure 3 - Code-to-Behavior Security Twin"; fontsize=15; fontcolor="#0B1F3A";
subgraph cluster_a { label="A. Code Representation"; style="rounded"; color="#0E7490"; fontcolor="#0E7490";
 a1 [label="Routes / controllers"]; a2 [label="Auth + authz checks"]; a3 [label="Models + DB operations"]; }
subgraph cluster_b { label="B. Runtime Representation"; style="rounded"; color="#0E7490"; fontcolor="#0E7490";
 b1 [label="HTTP request/response pairs"]; b2 [label="Identities + roles"]; b3 [label="DB state snapshots"]; }
subgraph cluster_c { label="C. Security Policy Representation"; style="rounded"; color="#0E7490"; fontcolor="#0E7490";
 c1 [label="Ownership rules"]; c2 [label="Role restrictions"]; c3 [label="Security invariants"]; }
X [label="Discrepancy Engine\nEvidence Correlation", shape=hexagon, fillcolor="#0B1F3A", fontcolor="white"];
OUT [label="Reproducible finding\n(invariant violated + evidence)", fillcolor="#FDE68A", color="#92400E"];
a1->X; a2->X; a3->X; b1->X; b2->X; b3->X; c1->X; c2->X; c3->X; X->OUT;
}
