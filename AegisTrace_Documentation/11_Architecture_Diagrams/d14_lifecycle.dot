digraph G { graph [bgcolor="white", fontname="DejaVu Sans", pad=0.3, nodesep=0.35, ranksep=0.5, labelloc=t, fontsize=16, fontcolor="#0B1F3A"]; node [fontname="DejaVu Sans", fontsize=12, shape=box, style="rounded,filled", fillcolor="#EAF6FB", color="#0B1F3A", penwidth=1.4, margin="0.16,0.09"]; edge [fontname="DejaVu Sans", fontsize=10, color="#0E7490", penwidth=1.3, arrowsize=0.8]; rankdir=TB; label="Figure 14 - Data Lifecycle";
c [label="Created\n(scan runs)", fillcolor="#7DD3E8"]; a [label="Active\n(engagement open)", fillcolor="#22A6C4"]; r [label="Retained\n(per policy)", fillcolor="#0E7490", fontcolor=white];
e [label="Expired / purged\n(by purge role)", fillcolor="#E5E7EB"]; l [label="Legal or audit hold\n(never purged)", fillcolor="#FDE68A", color="#92400E"];
c->a->r->e; r->l [style=dashed]; l->e [style=dashed, label="hold released"];
}
