digraph G { graph [bgcolor="white", fontname="DejaVu Sans", pad=0.3, nodesep=0.35, ranksep=0.5, labelloc=t, fontsize=16, fontcolor="#0B1F3A"]; node [fontname="DejaVu Sans", fontsize=12, shape=box, style="rounded,filled", fillcolor="#EAF6FB", color="#0B1F3A", penwidth=1.4, margin="0.16,0.09"]; edge [fontname="DejaVu Sans", fontsize=10, color="#0E7490", penwidth=1.3, arrowsize=0.8]; rankdir=LR; label="Figure A1 - Task State Transitions";
node [shape=ellipse];
q [label="queued"]; r [label="running", fillcolor="#7DD3E8"]; ok [label="succeeded", fillcolor="#BBF7D0", color="#166534"];
fl [label="failed", fillcolor="#FECACA", color="#991B1B"]; bl [label="blocked", fillcolor="#FDE68A", color="#92400E"];
ni [label="needs_input", fillcolor="#FDE68A", color="#92400E"]; ca [label="cancelled", fillcolor="#E5E7EB"];
q->r [label="dependencies met"]; r->ok [label="output valid"]; r->fl [label="error, retries exhausted"];
r->r [label="retryable error\n(attempt+1)"]; r->bl [label="scope violation /\nprecondition missing"]; r->ni [label="human or agent input needed"];
ni->r [label="input provided"]; bl->ca [label="operator stops"]; q->ca; r->ca;
}
